      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "断开 %1$arg"
          }
        }
      }
    },
    "Disconnected": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已断开"
          }
        }
      }
    },
    "Display": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示器"
          }
        }
      }
    },
    "Display & Quality": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示与画质"
          }
        }
      }
    },
    "Client DPI is a hint. RDP desktop pixel dimensions are not multiplied.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "客户端 DPI 仅作提示；不会按比例放大 RDP 桌面像素尺寸。"
          }
        }
      }
    },
    "Don't include your username.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请勿包含用户名。"
          }
        }
      }
    },
    "Include at least one uppercase letter.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请至少包含一个大写字母。"
          }
        }
      }
    },
    "Include at least one lowercase letter.": {
