            "value": "复制地址（%1$arg）"
          }
        }
      }
    },
    "Copy Command": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制命令"
          }
        }
      }
    },
    "Copy Password": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制密码"
          }
        }
      }
    },
    "Copy Remote Address (%arg)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制远程地址（%1$arg）"
          }
        }
      }
    },
    "Copy this token now; it won't be shown again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请立即复制此令牌；之后不会再次显示。"
          }
        }
      }
    },
    "Couldn't read the wake setting.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取网络唤醒设置。"
          }
        }
      }
    },
    "Couldn't save the password: %arg": {
